<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Murmur</string>
	<key>CFBundleDisplayName</key>
	<string>Murmur</string>
	<key>CFBundleIdentifier</key>
	<string>com.torimi.murmur</string>
	<key>CFBundleExecutable</key>
	<string>Murmur</string>
	<key>CFBundleIconFile</key>
	<string>Murmur</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- SpeechAnalyzer is macOS 26+. Below this the app would launch and
	     silently do nothing, so the floor has to be enforced here. -->
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>

	<!-- Menu bar only: no Dock icon, no main window. -->
	<key>LSUIElement</key>
	<true/>

	<!-- Required. Without it, requesting mic access crashes the process. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Murmur listens when you hold your dictation key. Audio is transcribed on this Mac and is never uploaded.</string>

	<!-- Right-click → "Correct with Murmur…" in any app that offers Services.
	     Return types mean it only appears on editable text, where the fix can
	     be put straight back in place. An NSRequiredContext — even an empty one
	     — makes macOS show it by default instead of starting it switched off. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Correct with Murmur…</string>
			</dict>
			<key>NSMessage</key>
			<string>correctWithMurmur</string>
			<key>NSPortName</key>
			<string>Murmur</string>
			<key>NSSendTypes</key>
			<array>
				<string>NSStringPboardType</string>
			</array>
			<key>NSReturnTypes</key>
			<array>
				<string>NSStringPboardType</string>
			</array>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSTimeout</key>
			<string>120000</string>
		</dict>
	</array>

	<key>NSHumanReadableCopyright</key>
	<string>Kian Torimi</string>
</dict>
</plist>
